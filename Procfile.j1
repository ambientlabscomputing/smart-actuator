sim:     bash -c 'cd smart-actuator && ACTUATOR_SIM_CONFIG=crates/actuator-sim/configs/default.yaml exec ./target/debug/actuator-sim run'
sidecar: bash -c 'cd smart-actuator && SIDECAR_CONFIG=crates/controller-sidecar/configs/default.yaml exec ./target/debug/controller-sidecar run'
brain:   bash -c 'cd brain && exec python -m brain.main'
ui:      bash -c 'cd ui && exec npm run dev'
