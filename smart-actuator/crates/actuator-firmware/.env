# actuator-firmware environment variables
# Copy to .env and fill in the values. .env is gitignored — never commit secrets.
#
# The Makefile sources this file automatically before every firmware-* target.
# The firmware reads these at build time (via Cargo env) or at runtime (via NVS).

# ── WiFi credentials ──────────────────────────────────────────────────────────
# The testbench ESP32 connects to this network as a WiFi station (STA mode).
# Must be a 2.4 GHz network (ESP32 does not support 5 GHz).
WIFI_SSID=LANb4Time
WIFI_PASSWORD=Thanksjose!

# ── Actuator identity ─────────────────────────────────────────────────────────
# Unique ID for this physical actuator. Used as the mDNS service instance name
# and as the actuator_id in the Sidecar's discovered-peer list.
# Use a short, lowercase, URL-safe string (e.g. "bench-j0", "testbench-0").
ACTUATOR_ID=bench-j0

# ── gRPC server ───────────────────────────────────────────────────────────────
# Port the firmware's ActuatorService gRPC server listens on.
# Must match the port expected by the Sidecar's discovery config.
ACTUATOR_GRPC_PORT=50051

# ── Serial flash ─────────────────────────────────────────────────────────────
# Override the auto-detected USB serial port (leave blank for auto-detect).
# Examples: /dev/tty.usbserial-0001  /dev/ttyUSB0
PORT=

# Serial baud rate for espflash. 460800 is reliable; increase to 921600 if
# your cable supports it.
BAUD=460800

# ── Tool versions (override if needed; defaults match the Makefile pins) ──────
# ESPUP_VERSION=1.4.1
# ESPFLASH_VERSION=3.4.0
# LDPROXY_VERSION=0.4.0
